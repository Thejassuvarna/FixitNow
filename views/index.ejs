<%# ========== HERO ========== %>
<section class="hero-bg relative isolate overflow-hidden text-white">
  <div class="hero-grid absolute inset-0 -z-10"></div>
  <div class="container-x grid items-center gap-12 pb-24 pt-16 lg:grid-cols-12 lg:pb-32 lg:pt-24">
    <div class="lg:col-span-7">
      <span class="glass mb-6 inline-flex animate-fade-up items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold text-brand-100">
        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span></span>
        <%= stats.workerTotal %>+ verified pros across <%= stats.cityTotal %> cities
      </span>
      <h1 class="animate-fade-up text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl lg:text-6xl" style="animation-delay:.08s">
        Skilled hands for every<br>home job, <span class="text-gradient animate-gradient-shift">just a call away.</span>
      </h1>
      <p class="mt-6 max-w-xl animate-fade-up text-lg leading-relaxed text-ink-200" style="animation-delay:.16s">
        Book trusted electricians, plumbers, mechanics, carpenters, painters and AC technicians in your neighbourhood. Clear ₹ rates. Real reviews. Zero hassle.
      </p>

      <%# Hero search %>
      <form action="/services" method="GET" id="hero-search" class="glass mt-9 animate-fade-up rounded-3xl p-3 shadow-lift sm:p-4" style="animation-delay:.24s" role="search">
        <div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
          <label class="relative block">
            <span class="sr-only">Service type</span>
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-brand-500"><%- icon('briefcase', 'h-5 w-5') %></span>
            <select name="category" id="hero-category" class="input !border-0 !py-3.5 !pl-12 font-semibold">
              <option value="">All services</option>
              <% categories.forEach((c) => { %><option value="<%= c.name %>"><%= c.icon %> <%= c.name %></option><% }) %>
            </select>
          </label>
          <label class="relative block">
            <span class="sr-only">Pincode or city</span>
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-brand-500"><%- icon('pin', 'h-5 w-5') %></span>
            <input type="text" name="location" id="hero-location" class="input !border-0 !py-3.5 !pl-12 font-semibold" placeholder="6-digit pincode or city" maxlength="40" autocomplete="off" data-pincode-hint>
          </label>
          <button type="submit" class="btn-primary !py-3.5 sm:px-8" id="hero-search-btn"><%- icon('search', 'h-5 w-5', 2.5) %> Search</button>
        </div>
        <p class="mt-3 hidden px-2 text-xs text-brand-200" id="pincode-hint-msg"></p>
        <div class="mt-3 flex flex-wrap items-center gap-2 px-1 text-xs text-ink-300">
          <span class="font-semibold">Try:</span>
          <a href="/services?location=574201" class="rounded-full bg-white/10 px-3 py-1 hover:bg-white/20">574201 Puttur</a>
          <a href="/services?location=560001" class="rounded-full bg-white/10 px-3 py-1 hover:bg-white/20">560001 Bengaluru</a>
          <a href="/services?location=Mangaluru" class="rounded-full bg-white/10 px-3 py-1 hover:bg-white/20">Mangaluru</a>
        </div>
      </form>
    </div>

    <%# Hero visual: floating cards %>
    <div class="relative hidden h-[460px] lg:col-span-5 lg:block" aria-hidden="true">
      <div class="absolute right-4 top-2 w-72 animate-float rounded-3xl bg-white p-5 text-ink-800 shadow-lift">
        <div class="flex items-center gap-3">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-xl">⚡</span>
          <div><p class="font-bold text-ink-900">Ramesh Shetty</p><p class="text-xs text-ink-500">Electrician · Puttur 574201</p></div>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-amber-400">★★★★★ <span class="font-bold text-ink-800">4.9</span></span>
          <span class="font-display text-xl font-extrabold">₹299<span class="text-xs font-semibold text-ink-400">/hr</span></span>
        </div>
        <div class="mt-4 flex items-center justify-between rounded-xl bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-700"><span>● Available now</span><span>₹150 inspection fee</span></div>
      </div>
      <div class="glass absolute bottom-16 left-0 w-64 animate-float-slow rounded-3xl p-5" style="animation-delay:1s">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-200">Just booked</p>
        <p class="mt-2 font-display text-lg font-bold text-white">AC service in Bengaluru</p>
        <p class="mt-1 text-sm text-ink-300">Fareed Khan · 560034</p>
        <p class="mt-3 text-sm font-semibold text-emerald-300">✓ Confirmed on WhatsApp</p>
      </div>
      <div class="absolute bottom-0 right-10 grid h-24 w-24 animate-float place-items-center rounded-3xl bg-gradient-to-br from-brand-500 to-amber-400 text-4xl shadow-glow" style="animation-delay:2s">🛠️</div>
    </div>
  </div>
</section>

<%# ========== STATS STRIP ========== %>
<section class="container-x relative z-10 -mt-12" data-reveal>
  <div class="card grid grid-cols-2 gap-6 p-6 text-center sm:grid-cols-4 sm:p-8">
    <div><p class="font-display text-3xl font-extrabold text-ink-900"><%= stats.workerTotal %>+</p><p class="text-sm text-ink-500">Verified professionals</p></div>
    <div><p class="font-display text-3xl font-extrabold text-ink-900"><%= stats.reviewTotal %>+</p><p class="text-sm text-ink-500">Customer reviews</p></div>
    <div><p class="font-display text-3xl font-extrabold text-ink-900"><%= stats.cityTotal %></p><p class="text-sm text-ink-500">Cities served</p></div>
    <div><p class="font-display text-3xl font-extrabold text-brand-600">₹0</p><p class="text-sm text-ink-500">Platform fee for customers</p></div>
  </div>
</section>

<%# ========== CATEGORIES ========== %>
<section class="container-x mt-24" id="categories">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
    <div>
      <p class="eyebrow">Browse by category</p>
      <h2 class="section-title">What do you need fixed today?</h2>
    </div>
    <a href="/services" class="btn-outline">View all pros <%- icon('arrow', 'h-4 w-4') %></a>
  </div>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
    <% categories.forEach((c, i) => { %>
      <a href="/services?category=<%= encodeURIComponent(c.name) %>" class="card card-hover group p-5 text-center" data-reveal style="transition-delay: <%= i * 60 %>ms" id="cat-<%= c.slug %>">
        <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br <%= c.gradient %> text-3xl shadow-soft transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110"><%= c.icon %></span>
        <h3 class="mt-4 text-base font-bold"><%= c.name %></h3>
        <p class="mt-1 text-xs text-ink-500"><%= c.tagline %></p>
        <p class="mt-3 text-xs font-bold text-brand-600"><%= c.count %> pro<%= c.count === 1 ? '' : 's' %> →</p>
      </a>
    <% }) %>
  </div>
</section>

<%# ========== FEATURED WORKERS ========== %>
<section class="container-x mt-24" id="featured">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
    <div>
      <p class="eyebrow"><%- icon('sparkle', 'h-4 w-4') %> Top rated</p>
      <h2 class="section-title">Featured professionals</h2>
      <p class="mt-2 text-ink-500">Hand-picked by ratings from real customers near you.</p>
    </div>
    <a href="/services?sort=rating" class="btn-outline">See more <%- icon('arrow', 'h-4 w-4') %></a>
  </div>
  <% if (featured.length) { %>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% featured.forEach((w, i) => { %>
        <div data-reveal style="transition-delay: <%= (i % 3) * 80 %>ms"><%- include('partials/workerCard', { w }) %></div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card p-10 text-center text-ink-500">No rated professionals yet. Be the first to <a class="font-semibold text-brand-600" href="/services">leave a review</a>.</div>
  <% } %>
</section>

<%# ========== HOW IT WORKS ========== %>
<section class="container-x mt-24" id="how-it-works">
  <div class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
    <p class="eyebrow justify-center">How it works</p>
    <h2 class="section-title">Fixed in three simple steps</h2>
    <p class="mt-3 text-ink-500">No middlemen, no surprise bills. Talk directly to the pro you choose.</p>
  </div>
  <div class="relative grid gap-6 md:grid-cols-3">
    <div class="absolute left-[16%] right-[16%] top-14 hidden border-t-2 border-dashed border-ink-200 md:block"></div>
    <% [
      { n: '01', icon: 'search', t: 'Search & compare', d: 'Pick a service, enter your pincode or city and compare rates, ratings and availability.' },
      { n: '02', icon: 'phone', t: 'Call or WhatsApp', d: 'Connect with your chosen pro in one tap. Discuss the job and agree on the visit time.' },
      { n: '03', icon: 'check', t: 'Get it fixed & review', d: 'Pay the pro directly in ₹ once the job is done, then rate your experience to help others.' },
    ].forEach((s, i) => { %>
      <div class="card relative p-7 text-center" data-reveal style="transition-delay: <%= i * 100 %>ms">
        <span class="relative mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-ink-900 text-white shadow-lift"><%- icon(s.icon, 'h-7 w-7') %>
          <span class="absolute -right-2 -top-2 grid h-7 w-7 place-items-center rounded-full bg-brand-500 text-[11px] font-extrabold"><%= s.n %></span>
        </span>
        <h3 class="mt-5 text-xl font-bold"><%= s.t %></h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-500"><%= s.d %></p>
      </div>
    <% }) %>
  </div>
</section>

<%# ========== TRUST + CTA ========== %>
<section class="container-x mt-24">
  <div class="hero-bg relative overflow-hidden rounded-[2rem] p-8 text-white sm:p-14" data-reveal>
    <div class="hero-grid absolute inset-0 opacity-60"></div>
    <div class="relative grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow !text-brand-300">For service professionals</p>
        <h2 class="text-3xl font-extrabold text-white sm:text-4xl">Grow your business with FixitNow</h2>
        <p class="mt-4 max-w-md text-ink-200">Create a free profile, set your own ₹ hourly rate and service pincodes, and get found by customers in your area. Toggle <strong class="text-white">Available / Busy</strong> anytime.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/auth/register?role=worker" class="btn-primary" id="cta-join">Join as a pro <%- icon('arrow', 'h-4 w-4') %></a>
          <a href="/services" class="btn border border-white/20 text-white hover:bg-white/10">Browse pros</a>
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        <% [['shield','Verified badge','Get verified to stand out and win trust.'],['pin','Pincode targeting','Be found in every pincode you serve.'],['phone','Direct calls','Customers reach you by Call or WhatsApp.'],['chart','Real reviews','Build a reputation with honest ratings.']].forEach((f) => { %>
          <li class="glass rounded-2xl p-5">
            <span class="text-brand-300"><%- icon(f[0], 'h-6 w-6') %></span>
            <p class="mt-3 font-bold text-white"><%= f[1] %></p>
            <p class="mt-1 text-sm text-ink-300"><%= f[2] %></p>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
