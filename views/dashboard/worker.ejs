<%
  const v = form || {
    category: worker.category, experienceYears: worker.experienceYears, hourlyRate: worker.hourlyRate,
    visitingCharges: worker.visitingCharges, address: worker.location.address, city: worker.location.city,
    state: worker.location.state, pincode: worker.location.pincode, servicePincodes: worker.servicePincodes,
    serviceRadiusKm: worker.serviceRadiusKm, skills: worker.skills, bio: worker.bio,
  };
  const phoneVal = form ? form.phone : worker.userId.phone;
  const meta = categoryMeta(worker.category);
%>
<section class="border-b border-ink-100 bg-white">
  <div class="container-x flex flex-wrap items-center justify-between gap-4 py-8">
    <div class="flex items-center gap-4">
      <% if (worker.photo) { %>
        <img src="<%= worker.photo %>" alt="" class="h-16 w-16 rounded-2xl object-cover shadow-soft">
      <% } else { %>
        <span class="grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br <%= avatarGradient(worker.userId.name) %> font-display text-xl font-bold text-white"><%= initials(worker.userId.name) %></span>
      <% } %>
      <div>
        <p class="text-sm font-semibold text-ink-400">Worker dashboard</p>
        <h1 class="text-2xl font-extrabold sm:text-3xl">Hello, <%= worker.userId.name.split(' ')[0] %> 👋</h1>
        <p class="text-sm text-ink-500"><%= meta.icon %> <%= worker.category %> · <%= worker.location.city %> <%= worker.location.pincode %>
          <% if (worker.isVerified) { %><span class="badge ml-1 bg-sky-50 text-sky-700"><%- icon('shield', 'h-3.5 w-3.5') %> Verified</span><% } else { %><span class="badge ml-1 bg-ink-100 text-ink-500">Verification pending</span><% } %>
          <% if (!worker.isActive) { %><span class="badge ml-1 bg-rose-50 text-rose-700">Hidden by admin</span><% } %>
        </p>
      </div>
    </div>
    <a href="/workers/<%= worker._id %>" class="btn-outline" id="view-public">View public profile <%- icon('arrow', 'h-4 w-4') %></a>
  </div>
</section>

<section class="container-x grid gap-8 py-10 lg:grid-cols-[1fr_340px]">
  <div class="space-y-8">

    <%# Availability toggle %>
    <div class="card flex flex-wrap items-center justify-between gap-5 p-6" id="availability-card">
      <div>
        <h2 class="text-lg font-bold">Availability status</h2>
        <p class="mt-1 text-sm text-ink-500">Customers see this on your card and profile. Switch to <strong>Busy</strong> when you can't take new jobs.</p>
      </div>
      <form action="/dashboard/worker/availability" method="POST" class="flex items-center gap-3" id="availability-form">
        <input type="hidden" name="available" id="availability-value" value="<%= !worker.isAvailable %>">
        <span id="availability-text" class="text-sm font-bold <%= worker.isAvailable ? 'text-emerald-600' : 'text-amber-600' %>"><%= worker.isAvailable ? 'Available' : 'Busy' %></span>
        <button type="submit" role="switch" id="availability-switch" class="switch" aria-checked="<%= worker.isAvailable %>" aria-label="Toggle availability"><span class="switch-knob"></span></button>
      </form>
    </div>

    <% if (errors.length) { %>
      <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700" role="alert" id="form-errors">
        <p class="mb-1 font-bold">Please fix the following:</p>
        <ul class="list-inside list-disc space-y-0.5"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
      </div>
    <% } %>

    <%# Profile form %>
    <form action="/dashboard/worker" method="POST" enctype="multipart/form-data" class="card space-y-8 p-6 sm:p-8" id="profile-form">
      <div>
        <h2 class="text-lg font-bold">Contact details</h2>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="phone" class="label">Mobile / WhatsApp number *</label>
            <input type="tel" name="phone" id="phone" class="input" value="<%= phoneVal || '' %>" placeholder="9876543210" required inputmode="numeric" minlength="10" maxlength="10" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)">
            <p class="hint">Customers use this for Call &amp; WhatsApp booking.</p>
          </div>
          <div>
            <label class="label" for="email-ro">Email</label>
            <input type="email" id="email-ro" class="input bg-ink-50 text-ink-500" value="<%= worker.userId.email %>" disabled>
          </div>
        </div>
      </div>
      <div class="border-t border-dashed border-ink-200 pt-8">
        <h2 class="mb-4 text-lg font-bold">Profile &amp; pricing</h2>
        <%- include('../partials/workerFields', { v, categories, states, currentPhoto: worker.photo || '' }) %>
      </div>

      <%# Work Portfolio Photos upload inside profile form %>
      <div class="border-t border-dashed border-ink-200 pt-8" id="work-photos-section">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <h2 class="text-lg font-bold">Work Portfolio Photos</h2>
          <% if (worker.workImages && worker.workImages.length) { %>
            <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-600">
              <%= worker.workImages.length %> photo<%= worker.workImages.length === 1 ? '' : 's' %>
            </span>
          <% } %>
        </div>
        <p class="mb-4 text-sm text-ink-500">Showcase recent jobs, completed projects, and quality of work to potential clients.</p>

        <label class="block mb-2 text-sm font-semibold text-ink-700" for="workPhotos">
          Upload new portfolio photos <span class="font-normal text-ink-400">(JPG, PNG, WEBP, up to 5MB each)</span>
        </label>
        <input type="file" name="workPhotos" id="workPhotos" multiple accept="image/*"
          class="block w-full text-sm text-ink-600 file:mr-4 file:cursor-pointer file:rounded-xl file:border-0 file:bg-brand-50 file:px-4 file:py-2.5 file:text-xs file:font-semibold file:text-brand-700 hover:file:bg-brand-100 rounded-xl border border-ink-200 bg-white p-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
        <p class="mt-2 text-xs text-ink-400">Photos will be saved to your portfolio when you click "Save changes".</p>
      </div>

      <div class="flex justify-end gap-3">
        <a href="/dashboard/worker" class="btn-ghost">Reset</a>
        <button type="submit" class="btn-primary" id="save-profile">Save changes</button>
      </div>
    </form>

    <%# Existing photo thumbnails management card alongside profile edit form %>
    <div class="card p-6 sm:p-8" id="manage-portfolio-photos">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div>
          <h2 class="text-lg font-bold">Manage Existing Portfolio Photos</h2>
          <p class="text-sm text-ink-500">Remove photos you no longer want to display on your public profile.</p>
        </div>
        <% if (worker.workImages && worker.workImages.length) { %>
          <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-600">
            <%= worker.workImages.length %> photo<%= worker.workImages.length === 1 ? '' : 's' %>
          </span>
        <% } %>
      </div>

      <% if (worker.workImages && worker.workImages.length) { %>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3 mb-6">
          <% worker.workImages.forEach((img, idx) => { %>
            <% const imgSrc = typeof img === 'string' ? img : (img.url || img); %>
            <div class="group relative aspect-square overflow-hidden rounded-2xl border border-ink-200 bg-ink-100 shadow-sm">
              <a href="<%= imgSrc %>" target="_blank" rel="noopener noreferrer" class="block h-full w-full">
                <img src="<%= imgSrc %>" alt="Portfolio photo <%= idx + 1 %>" class="h-full w-full object-cover">
              </a>
              <form action="/workers/<%= worker._id %>/photos/<%= idx %>/delete" method="POST" class="absolute top-2 right-2" onsubmit="return confirm('Remove this work photo?');">
                <input type="hidden" name="returnTo" value="/dashboard/worker">
                <button type="submit" class="grid h-7 w-7 place-items-center rounded-lg bg-black/70 text-white backdrop-blur hover:bg-rose-600 transition" title="Delete photo">
                  <%- icon('trash', 'h-3.5 w-3.5') %>
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="mb-5 text-sm text-ink-400">No portfolio photos currently uploaded.</p>
      <% } %>

      <form action="/workers/<%= worker._id %>/photos" method="POST" enctype="multipart/form-data" class="rounded-2xl border-2 border-dashed border-ink-200 bg-ink-50/50 p-5">
        <input type="hidden" name="returnTo" value="/dashboard/worker">
        <label class="block mb-2 text-sm font-semibold text-ink-700" for="directWorkPhotos">
          Or upload photos immediately to your portfolio
        </label>
        <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
          <input type="file" name="workPhotos" id="directWorkPhotos" multiple accept="image/*" required
            class="block w-full text-sm text-ink-600 file:mr-4 file:cursor-pointer file:rounded-xl file:border-0 file:bg-brand-50 file:px-4 file:py-2.5 file:text-xs file:font-semibold file:text-brand-700 hover:file:bg-brand-100 rounded-xl border border-ink-200 bg-white p-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <button type="submit" class="btn-primary shrink-0">Upload Now</button>
        </div>
      </form>
    </div>
  </div>

  <aside class="space-y-6">
    <div class="card overflow-hidden">
      <div class="bg-gradient-to-br <%= meta.gradient %> p-6 text-white">
        <p class="text-xs font-bold uppercase tracking-widest text-white/80">Your current rate</p>
        <p class="font-display text-4xl font-extrabold" id="stat-rate"><%= formatINR(worker.hourlyRate) %><span class="text-base font-semibold text-white/80">/hr</span></p>
        <p class="text-sm text-white/90"><%= worker.visitingCharges ? formatINR(worker.visitingCharges) + ' inspection fee' : 'Free inspection' %></p>
      </div>
      <div class="grid grid-cols-2 divide-x divide-ink-100 text-center">
        <div class="p-5"><p class="font-display text-3xl font-extrabold"><%= worker.reviewsCount ? worker.averageRating.toFixed(1) : '–' %></p><p class="text-xs text-ink-500">Average rating</p></div>
        <div class="p-5"><p class="font-display text-3xl font-extrabold"><%= worker.reviewsCount %></p><p class="text-xs text-ink-500">Reviews</p></div>
      </div>
    </div>

    <div class="card p-6">
      <h2 class="text-lg font-bold">Recent reviews</h2>
      <% if (!recent.length) { %>
        <p class="mt-3 text-sm text-ink-400">No reviews yet. Great service gets great reviews!</p>
      <% } %>
      <ul class="mt-4 space-y-4">
        <% recent.forEach((r) => { %>
          <li class="border-b border-ink-100 pb-4 last:border-0 last:pb-0">
            <div class="flex items-center justify-between"><p class="text-sm font-bold"><%= r.customerId ? r.customerId.name : 'Customer' %></p><%- renderStars(r.rating, 'text-sm') %></div>
            <p class="mt-1 line-clamp-3 text-sm text-ink-500"><%= r.comment %></p>
            <p class="mt-1 text-xs text-ink-300"><%= timeAgo(r.createdAt) %></p>
          </li>
        <% }) %>
      </ul>
    </div>
  </aside>
</section>
