<section class="border-b border-ink-100 bg-white">
  <div class="container-x py-10">
    <nav class="mb-3 text-xs font-semibold text-ink-400" aria-label="Breadcrumb"><a href="/" class="hover:text-brand-600">Home</a> / <span class="text-ink-600">Find pros</span></nav>
    <h1 class="text-3xl font-extrabold sm:text-4xl">
      <%= query.category ? query.category + 's' : 'Local service professionals' %>
      <% if (query.location) { %><span class="text-brand-600">near <%= query.location %></span><% } %>
    </h1>
    <p class="mt-2 text-ink-500"><strong class="text-ink-800"><%= total %></strong> professional<%= total === 1 ? '' : 's' %> found · all rates in ₹ (INR)</p>

    <%# Category badges %>
    <div class="no-scrollbar -mx-4 mt-6 flex gap-2 overflow-x-auto px-4 pb-1" id="category-badges">
      <a href="/services?<%= new URLSearchParams(Object.entries({ ...query, category: '' }).filter(([, v]) => v)).toString() %>"
         class="chip whitespace-nowrap <%= !query.category ? 'chip-active' : '' %>">All</a>
      <% categories.forEach((c) => { %>
        <a href="/services?<%= new URLSearchParams(Object.entries({ ...query, category: c.name }).filter(([, v]) => v)).toString() %>"
           class="chip whitespace-nowrap <%= query.category === c.name ? 'chip-active' : '' %>"><%= c.icon %> <%= c.name %></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="container-x grid gap-8 py-10 lg:grid-cols-[300px_1fr]">
  <%# ===== Filters ===== %>
  <aside>
    <form action="/services" method="GET" id="filter-form" class="card sticky top-24 space-y-6 p-5" aria-label="Filters">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-bold"><%- icon('sliders', 'h-5 w-5 text-brand-500') %> Filters</h2>
        <a href="/services" class="text-xs font-semibold text-brand-600 hover:underline" id="clear-filters">Clear all</a>
      </div>

      <div>
        <label for="f-category" class="label">Service</label>
        <select name="category" id="f-category" class="input">
          <option value="">All services</option>
          <% categories.forEach((c) => { %><option value="<%= c.name %>" <%= query.category === c.name ? 'selected' : '' %>><%= c.icon %> <%= c.name %></option><% }) %>
        </select>
      </div>

      <div>
        <label for="f-location" class="label">Pincode or city</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-300"><%- icon('pin', 'h-4 w-4') %></span>
          <input type="text" name="location" id="f-location" value="<%= query.location %>" class="input !pl-10" placeholder="e.g. 574201 or Mangaluru" maxlength="40" autocomplete="off" data-pincode-hint>
        </div>
        <p class="hint" id="pincode-hint-msg">Enter a 6-digit pincode or a city name.</p>
      </div>

      <fieldset>
        <legend class="label">Price per hour</legend>
        <div class="grid gap-2">
          <% priceRanges.forEach((p, i) => { %>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border px-3.5 py-2.5 text-sm font-semibold transition has-[:checked]:border-brand-400 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-700 border-ink-200 text-ink-600 hover:border-ink-300">
              <input type="radio" name="price" value="<%= p.value %>" class="h-4 w-4 accent-brand-500" <%= query.price === p.value ? 'checked' : '' %> data-autosubmit>
              <%= p.label %>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <fieldset>
        <legend class="label">Minimum rating</legend>
        <div class="grid grid-cols-3 gap-2">
          <% [['', 'Any'], ['3', '3+ ★'], ['4', '4+ ★']].forEach(([v, l]) => { %>
            <label class="cursor-pointer rounded-xl border border-ink-200 px-2 py-2.5 text-center text-sm font-semibold text-ink-600 transition hover:border-ink-300 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-50 has-[:checked]:text-amber-700">
              <input type="radio" name="rating" value="<%= v %>" class="sr-only" <%= query.rating === v ? 'checked' : '' %> data-autosubmit><%= l %>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <label class="flex cursor-pointer items-center justify-between rounded-xl bg-ink-50 px-4 py-3 text-sm font-semibold text-ink-700">
        Available now only
        <input type="checkbox" name="available" value="1" class="h-5 w-5 accent-emerald-500" <%= query.available ? 'checked' : '' %> data-autosubmit>
      </label>

      <input type="hidden" name="sort" value="<%= query.sort %>">
      <button type="submit" class="btn-primary w-full" id="apply-filters"><%- icon('search', 'h-4 w-4', 2.5) %> Apply filters</button>
    </form>
  </aside>

  <%# ===== Results ===== %>
  <div>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-ink-500">Showing page <strong class="text-ink-800"><%= page %></strong> of <%= totalPages %></p>
      <form action="/services" method="GET" class="flex items-center gap-2" id="sort-form">
        <% Object.entries(query).forEach(([k, v]) => { if (v && k !== 'sort') { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } }) %>
        <label for="sort" class="text-sm font-semibold text-ink-500">Sort by</label>
        <select name="sort" id="sort" class="input !w-auto !py-2" data-autosubmit>
          <% [['rating','Top rated'],['reviews','Most reviewed'],['priceLow','Price: low to high'],['priceHigh','Price: high to low'],['experience','Most experienced']].forEach(([v, l]) => { %>
            <option value="<%= v %>" <%= query.sort === v ? 'selected' : '' %>><%= l %></option>
          <% }) %>
        </select>
      </form>
    </div>

    <% if (workers.length) { %>
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3" id="results-grid">
        <% workers.forEach((w, i) => { %>
          <div data-reveal style="transition-delay: <%= (i % 3) * 70 %>ms"><%- include('../partials/workerCard', { w }) %></div>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="mt-10 flex items-center justify-center gap-2" aria-label="Pagination">
          <% const link = (p) => `/services?${baseQuery ? baseQuery + '&' : ''}page=${p}`; %>
          <% if (page > 1) { %><a href="<%= link(page - 1) %>" class="btn-outline btn-sm">← Prev</a><% } %>
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a href="<%= link(p) %>" class="grid h-9 w-9 place-items-center rounded-lg text-sm font-bold <%= p === page ? 'bg-ink-900 text-white' : 'bg-white text-ink-600 hover:bg-ink-100 border border-ink-200' %>"><%= p %></a>
          <% } %>
          <% if (page < totalPages) { %><a href="<%= link(page + 1) %>" class="btn-outline btn-sm">Next →</a><% } %>
        </nav>
      <% } %>
    <% } else { %>
      <div class="card flex flex-col items-center px-6 py-16 text-center" id="no-results">
        <span class="grid h-20 w-20 place-items-center rounded-full bg-ink-50 text-4xl">🔍</span>
        <h2 class="mt-5 text-2xl font-bold">No professionals match your filters</h2>
        <p class="mt-2 max-w-sm text-ink-500">Try a different pincode, widen the price range or clear filters to see everyone.</p>
        <a href="/services" class="btn-primary mt-6">Clear all filters</a>
      </div>
    <% } %>
  </div>
</section>
