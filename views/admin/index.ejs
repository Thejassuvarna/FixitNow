<section class="border-b border-ink-100 bg-white">
  <div class="container-x py-8">
    <p class="text-sm font-semibold text-ink-400">Administration</p>
    <h1 class="text-3xl font-extrabold">Moderation console</h1>
  </div>
</section>

<section class="container-x space-y-10 py-10">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <% [['Total users', stats.userTotal, 'user'], ['Worker listings', stats.workerTotal, 'briefcase'], ['Reviews', stats.reviewTotal, 'chart'], ['Awaiting verification', stats.pendingVerify, 'shield']].forEach((s) => { %>
      <div class="card flex items-center gap-4 p-5">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-50 text-brand-600"><%- icon(s[2], 'h-6 w-6') %></span>
        <div><p class="font-display text-3xl font-extrabold"><%= s[1] %></p><p class="text-xs text-ink-500"><%= s[0] %></p></div>
      </div>
    <% }) %>
  </div>

  <div id="workers" class="scroll-mt-24">
    <h2 class="mb-4 text-xl font-bold">Worker listings</h2>
    <div class="card overflow-x-auto">
      <table class="w-full min-w-[820px] text-left text-sm">
        <thead class="border-b border-ink-100 bg-ink-50 text-xs uppercase tracking-wider text-ink-500">
          <tr><th class="px-5 py-3">Worker</th><th class="px-5 py-3">Category</th><th class="px-5 py-3">Location</th><th class="px-5 py-3">Rate</th><th class="px-5 py-3">Rating</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Actions</th></tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          <% workers.forEach((w) => { %>
            <tr class="hover:bg-ink-50/60" data-worker-row>
              <td class="px-5 py-3"><a href="/workers/<%= w._id %>" class="font-bold text-ink-900 hover:text-brand-600"><%= w.userId.name %></a><p class="text-xs text-ink-400"><%= w.userId.email %></p></td>
              <td class="px-5 py-3"><%= w.category %></td>
              <td class="px-5 py-3"><%= w.location.city %> <span class="text-ink-400"><%= w.location.pincode %></span></td>
              <td class="px-5 py-3 font-semibold"><%= formatINR(w.hourlyRate) %>/hr</td>
              <td class="px-5 py-3"><%= w.reviewsCount ? w.averageRating.toFixed(1) + ' ★ (' + w.reviewsCount + ')' : '–' %></td>
              <td class="px-5 py-3">
                <span class="badge <%= w.isVerified ? 'bg-sky-50 text-sky-700' : 'bg-ink-100 text-ink-500' %>"><%= w.isVerified ? 'Verified' : 'Unverified' %></span>
                <span class="badge <%= w.isActive ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>"><%= w.isActive ? 'Live' : 'Hidden' %></span>
              </td>
              <td class="px-5 py-3">
                <div class="flex justify-end gap-2">
                  <form action="/admin/workers/<%= w._id %>/verify" method="POST"><button class="btn-outline btn-sm"><%= w.isVerified ? 'Unverify' : 'Verify' %></button></form>
                  <form action="/admin/workers/<%= w._id %>/active" method="POST"><button class="<%= w.isActive ? 'btn-danger' : 'btn-dark' %> btn-sm"><%= w.isActive ? 'Hide' : 'Show' %></button></form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div id="reviews" class="scroll-mt-24">
    <h2 class="mb-4 text-xl font-bold">Latest reviews</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <% if (!reviews.length) { %><p class="text-ink-400">No reviews to moderate.</p><% } %>
      <% reviews.forEach((r) => { %>
        <div class="card p-5" data-review-row>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm"><strong><%= r.customerId.name %></strong> <span class="text-ink-400">on</span> <a class="font-semibold text-brand-600 hover:underline" href="/workers/<%= r.workerId._id %>"><%= r.workerId.userId.name %></a></p>
              <div class="mt-1 flex items-center gap-2"><%- renderStars(r.rating, 'text-sm') %><span class="text-xs text-ink-400"><%= formatDate(r.createdAt) %></span></div>
            </div>
            <form action="/admin/reviews/<%= r._id %>/delete" method="POST" data-confirm="Delete this review? The worker's rating will be recalculated."><button class="btn-danger btn-sm"><%- icon('trash', 'h-3.5 w-3.5') %> Delete</button></form>
          </div>
          <p class="mt-3 break-words text-sm text-ink-600"><%= r.comment %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
