{
  "name": "localfix",
  "version": "1.0.0",
  "description": "LocalFix - on-demand marketplace connecting users with trusted local service professionals in India",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm:css:watch\" \"nodemon server.js\"",
    "css:build": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "seed": "node seed/seedData.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.5",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19"
  }
}
